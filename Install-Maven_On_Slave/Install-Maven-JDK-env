#!/bin/bash

### Run on Jenkins Slave using CLI on Linux Terminal ###

## Java

sudo yum install java-17-openjdk -y
readlink -f $(which java)

cat <<EOF | sudo tee /etc/profile.d/java.sh
export JAVA_HOME=/usr/lib/jvm/java-17-openjdk
export PATH=$PATH:$JAVA_HOME/bin
EOF

source /etc/profile.d/java.sh
echo $JAVA_HOME


## Maven

cd /opt
sudo wget https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.tar.gz
sudo tar -xvzf apache-maven-3.9.9-bin.tar.gz
sudo mv apache-maven-3.9.9 maven

cat <<EOF | sudo tee /etc/profile.d/maven.sh
export M2_HOME=/opt/maven
export PATH=$M2_HOME/bin:$PATH
EOF

source /etc/profile.d/maven.sh
mvn -version

